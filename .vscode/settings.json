{
  // Ce projet est un projet Flutter. Le dossier `android/` contient des
  // fichiers Gradle, ce qui suffit à réveiller l'extension Java (redhat.java)
  // et l'extension Gradle : import du projet, indexation, démon Gradle. Rien de
  // tout cela ne sert ici, et ce travail bloque le thread principal de VS Code
  // assez longtemps pour que GNOME affiche « ne répond pas ».
  //
  // Ces réglages neutralisent ce travail. Pour couper court complètement, il
  // faut désactiver les extensions pour l'espace de travail depuis l'onglet
  // Extensions — l'état d'activation n'est pas stockable dans un fichier.

  // Serveur de langage Java en mode syntaxe seule : pas de build du projet.
  "java.server.launchMode": "LightWeight",

  // Ne pas importer les projets Gradle / Maven trouvés dans l'arborescence.
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.project.importOnFirstTimeStartup": "disabled",
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.import.exclusions": ["**/android/**", "**/ios/**", "**/build/**"],

  // Pas de compilation ni d'analyse en arrière-plan.
  "java.autobuild.enabled": false,
  "java.compile.nullAnalysis.mode": "disabled",

  // Pas de détection automatique des tâches Gradle (évite le démon Gradle).
  "gradle.autoDetect": "off",
  "gradle.nestedProjects": false,

  // Les dossiers générés n'ont aucune raison d'être surveillés ni indexés.
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/android/.gradle/**": true,
    "**/.gradle/**": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.dart_tool": true,
    "**/lib/l10n/app_localizations*.dart": true
  }
}
