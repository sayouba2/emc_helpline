{
  "name": "emc-helpline-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for EMC Helpline — see the repository README.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
